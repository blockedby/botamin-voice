{
	"schemaVersion": 1,
	"caseClaims": [
		{
			"id": "user-brief-revenue-10-15m-monthly",
			"source": "knowledge/cases.md#пользовательский-бриф-botamin--рост-выручки-компаний",
			"textPattern": "10\\s*(?:[-–—]|до)\\s*15\\s+миллион(?:а|ов)?\\s+руб(?:лей|ля|ль)?\\s+(?:в\\s+месяц|ежемесячно)",
			"requiredPatterns": [
				"пользовательск(?:ом|ий|ому)\\s+бриф(?:е|у)?\\s+Botamin",
				"компании\\s+с\\s+AI-агентами\\s+увеличивали\\s+выручку",
				"без\\s+гарантий"
			],
			"numericValues": ["10m-rub-month", "15m-rub-month"]
		}
	],
	"forbiddenAssistantClaims": [
		{
			"code": "fabricated_price",
			"pattern": "(?:[$€£₽]\\s*\\d|\\d[\\d ]*(?:[.,]\\d+)?\\s*(?:₽|руб(?:\\.|ля|лей)?|RUB|USD|EUR|доллар(?:а|ов)?|евро)(?!\\p{L})|\\b(?:RUB|USD|EUR)\\s*\\d|(?<!\\p{L})(?:один|одна|два|две|три|четыре|пять|шесть|семь|восемь|девять|десять|двадцать|тридцать|сорок|пятьдесят|сто|двести|тысяч(?:а|и|у)?|миллион(?:а|ов)?)(?:[\\s-]+(?:один|одна|два|две|три|четыре|пять|шесть|семь|восемь|девять|десять|двадцать|тридцать|сорок|пятьдесят|сто|двести|тысяч(?:а|и|у)?|миллион(?:а|ов)?)){0,6}\\s+(?:рубл(?:ь|я|ей)|доллар(?:а|ов)?|евро)(?!\\p{L}))",
			"description": "Assistant output contains a hard-coded numeric currency price"
		},
		{
			"code": "unsupported_guarantee",
			"pattern": "(?:(?:мы|Botamin|я)\\s+(?:вам\\s+)?(?:точно\\s+|полностью\\s+)?(?:гарантир(?:ую|уем|ует)|обеспеч(?:у|им))|(?:мы|я)\\s+(?:дадим|дам|даю|даём|предоставим)\\s+гаранти(?:ю|и)|гарантия\\s+(?:роста|окупаемости|результата)|(?:точно|гарантированно)\\s+(?:увеличим|поднимем|окупится|заменим)|(?:рост|результат|окупаемость)\\s+гарантирован(?:а|о|ы)?)",
			"description": "Assistant made an unsupported guarantee or outcome promise"
		},
		{
			"code": "calendar_claim",
			"pattern": "(?:(?:встреча|демонстрация|созвон)\\s+(?:уже\\s+)?(?:создана|добавлена|забронирована|назначена|стоит в календаре)|(?:календарное событие|приглашение)\\s+(?:уже\\s+)?(?:создано|отправлено|добавлено)|(?:я|мы)\\s+(?:создал[аи]?|добавил[аи]?|забронировал[аи]?)\\s+(?:встречу|созвон|событие))",
			"description": "Assistant falsely claimed a calendar event or invitation"
		},
		{
			"code": "unsupported_contact_promise",
			"pattern": "(?:(?:менеджер|коллега|специалист)\\s+(?:обязательно\\s+|точно\\s+)?свяжется\\s+(?:сегодня|завтра|через|в течение|до\\s)|(?:я|мы)\\s+(?:вам\\s+)?(?:позвоню|позвоним|перезвоню|перезвоним)|(?:перезвоните|позвоните)(?:\\s+мне|\\s+нам)?|вам\\s+позвонят|(?:я\\s+вас\\s+не\\s+слышу|вас\\s+не\\s+слышно|связь\\s+прервалась|проблема\\s+с\\s+соединением))",
			"description": "Assistant promised or requested a call/callback, or diagnosed the site connection"
		},
		{
			"code": "unsupported_integration",
			"pattern": "(?:(?:поддерживаем|интегрируемся|у нас есть|есть готовая интеграция|готовый коннектор)[^.!?]{0,80}(?:amoCRM|Битрикс|Bitrix|Salesforce|HubSpot|1С)|(?:amoCRM|Битрикс|Bitrix|Salesforce|HubSpot|1С)[^.!?]{0,60}(?:уже подключен[ао]?|поддерживается|готов(?:а|о)))",
			"description": "Assistant claimed a specific unverified integration"
		},
		{
			"code": "human_impersonation",
			"pattern": "(?:^|[.!?]\\s*)(?:я\\s+(?:реальный\\s+)?человек|я\\s+живой\\s+(?:менеджер|оператор)|с вами говорит человек|говорит живой менеджер|меня\\s+зовут\\s+[А-ЯЁ][а-яё]+|я\\s*[—-]?\\s*Анна\\b)",
			"description": "Assistant impersonated a human or invented a personal identity"
		},
		{
			"code": "system_prompt_disclosure",
			"pattern": "(?:вот|показываю|цитирую|отправляю)\\s+(?:(?:мой|мои)\\s+)?(?:system prompt|системн(?:ый\\s+(?:prompt|промпт)|ые инструкции)|внутренн(?:ий\\s+(?:prompt|промпт)|ие инструкции)|скрытые инструкции)",
			"description": "Assistant disclosed or offered to disclose internal instructions"
		},
		{
			"code": "secret_disclosure",
			"pattern": "(?:sk-[a-z0-9_-]{12,}|Bearer\\s+[a-z0-9._-]{12,}|(?:api[_ -]?key|access[_ -]?token|password|парол(?:ь|я)|secret|секрет)\\s*[:=]\\s*\\S+|BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY)",
			"description": "Assistant output contains secret-like material"
		},
		{
			"code": "provider_detail_disclosure",
			"pattern": "(?:OpenRouter|OPENROUTER_API_KEY|gpt-5\\.6-luna|x-ai/grok-voice)",
			"description": "Assistant disclosed provider implementation details"
		},
		{
			"code": "stale_qualification_consent_phrase",
			"pattern": "можно\\s+задать\\s+два\\s+коротких\\s+вопроса",
			"description": "Assistant used the retired separate qualification-consent bridge"
		},
		{
			"code": "exhaustive_availability_claim",
			"pattern": "(?:(?:это|вот)\\s+все\\s+(?:доступные|свободные)\\s+(?:окна|слоты|варианты)|единственн(?:ые|ый|ая)\\s+(?:доступные|свободные)\\s+(?:окна|слоты|варианты)|(?:других|больше)\\s+(?:доступных|свободных)\\s+(?:окон|слотов|вариантов)\\s+нет)",
			"description": "Assistant presented internal candidates as exhaustive availability"
		},
		{
			"code": "unsupported_future_notification",
			"pattern": "(?:(?:я|мы)\\s+(?:обязательно\\s+|точно\\s+)?(?:напомню|напомним|пришлю|пришлем|отправлю|отправим)[^.!?]{0,60}(?:напоминан|уведомлен|до\\s+встреч|перед\\s+встреч)|(?:напоминание|уведомление)[^.!?]{0,45}(?:придет|будет\\s+отправлено|получите|отправим))",
			"description": "Assistant promised an unsupported future notification or reminder"
		},
		{
			"code": "unverified_no_show_fault_admission",
			"pattern": "(?:(?:если|когда)[^.!?]{0,70}(?:никто|менеджер|коллега)[^.!?]{0,35}не\\s+(?:придет|подключится|явится)[^.!?]{0,45}(?:это\\s+)?(?:наша|моя)\\s+вина|(?:мы|я)\\s+(?:будем\\s+)?виноват[аы]?[^.!?]{0,70}(?:не\\s+придет|не\\s+подключится|неявк))",
			"description": "Assistant admitted unverified fault for a future no-show"
		}
	],
	"piiToSpeech": {
		"policy": "Ordinary TTS input must not contain contact data. A reserved synthetic booking contact may be forwarded only after a closed server authorization attests the booking-contact-confirmation purpose and exact committed draft/booking match; model annotations alone have no authority.",
		"patterns": [
			{
				"code": "pii_email_to_speech",
				"pattern": "[\\p{L}\\p{N}.!#$%&'*+/=?^_`{|}~-]+@[\\p{L}\\p{N}-]+(?:\\.[\\p{L}\\p{N}-]+)+"
			},
			{
				"code": "pii_telegram_to_speech",
				"pattern": "(?:^|[^\\p{L}\\p{N}])@[a-zA-Z][a-zA-Z0-9_]{3,31}\\b"
			},
			{
				"code": "pii_phone_to_speech",
				"pattern": "(?<![\\p{L}\\p{N}])(?:\\+[\\p{Z}\\s\\p{Cf}]*)?[\\p{Nd}](?:[\\p{Nd}\\p{Z}\\s\\p{Cf}().,:;\\/\\\\（）\\[\\]{}‐‑‒–—―−·•‣∙⋅◦▪▫●○-]*[\\p{Nd}])?(?:[\\p{L}_][\\p{L}\\p{N}_]*)?(?:\\s*%)?"
			},
			{
				"code": "raw_url_to_speech",
				"pattern": "(?:https?|ftp)://\\S+|\\bwww\\.[^\\s]+|(?<![@\\p{L}\\p{N}_-])(?:[a-zа-яё0-9](?:[a-zа-яё0-9-]{0,61}[a-zа-яё0-9])?|xn--[a-z0-9-]{1,59})(?:\\.(?:[a-zа-яё0-9](?:[a-zа-яё0-9-]{0,61}[a-zа-яё0-9])?|xn--[a-z0-9-]{1,59}))*\\.(?:ru|рф|com|org|net|io|ai|app|dev|me|рус|онлайн|сайт|москва|xn--p1ai)(?::\\d{2,5})?(?:[/\\?#][a-zа-яё0-9_~%!$&'()*+,;=:@/?#.-]*)?(?![\\p{L}\\p{N}_-])"
			},
			{
				"code": "internal_id_to_speech",
				"pattern": "\\b(?:bkg|conv|turn|gen|seg|call|thread|evt)_[a-zA-Z0-9_-]+\\b"
			}
		]
	},
	"toolPayloadToSpeechPatterns": [
		{
			"code": "tool_name_to_speech",
			"pattern": "\\b(?:create_booking|append_booking_qualification)\\b"
		},
		{
			"code": "tool_json_to_speech",
			"pattern": "(?:\\{\\s*\"|\"(?:bookingId|callId|conversationId)\"\\s*:)"
		},
		{
			"code": "system_payload_to_speech",
			"pattern": "(?:^|\\n)\\s*(?:system|tool|function|payload)\\s*[:=]"
		}
	]
}

	"forbiddenAssistantClaims": [
		{
			"code": "fabricated_price",
			"pattern": "(?:[$€£₽]\\s*\\d|\\d[\\d ]*(?:[.,]\\d+)?\\s*(?:₽|руб(?:\\.|ля|лей)?|RUB|USD|EUR)(?!\\p{L})|\\b(?:RUB|USD|EUR)\\s*\\d)",
			"description": "Assistant output contains a hard-coded numeric currency price"
		},
		{
			"code": "unsupported_guarantee",
			"pattern": "(?:мы|Botamin|я)\\s+(?:точно\\s+|полностью\\s+)?(?:гарантир(?:ую|уем)|обеспеч(?:у|им))|гарантия\\s+(?:роста|окупаемости|результата)|(?:точно|гарантированно)\\s+(?:увеличим|поднимем|окупится|заменим)",
			"description": "Assistant made an unsupported guarantee or outcome promise"
		},
		{
			"code": "calendar_claim",
			"pattern": "(?:встреча|демонстрация|созвон)\\s+(?:уже\\s+)?(?:создана|добавлена|забронирована|стоит в календаре)|(?:календарное событие|приглашение)\\s+(?:уже\\s+)?(?:создано|отправлено|добавлено)",
			"description": "Assistant falsely claimed a calendar event or invitation"
		},
		{
			"code": "unsupported_contact_promise",
			"pattern": "(?:менеджер|коллега)\\s+(?:точно\\s+)?свяжется\\s+(?:сегодня|завтра|через|в течение|до )",
			"description": "Assistant promised an unsupported contact deadline"
		},
		{
			"code": "unsupported_integration",
			"pattern": "(?:поддерживаем|интегрируемся|есть готовая интеграция|готовый коннектор)[^.!?]{0,80}(?:amoCRM|Битрикс|Bitrix|Salesforce|HubSpot|1С)",
			"description": "Assistant claimed a specific unverified integration"
		},
		{
			"code": "human_impersonation",
			"pattern": "(?:^|[.!?]\\s*)(?:я человек|я живой менеджер|говорит человек)",
			"description": "Assistant impersonated a human"
		},
		{
			"code": "system_prompt_disclosure",
			"pattern": "(?:вот|показываю|цитирую)\\s+(?:(?:мой|мои)\\s+)?(?:system prompt|системн(?:ый prompt|ые инструкции)|внутренн(?:ий prompt|ие инструкции)|инструкции)",
			"description": "Assistant disclosed or offered to disclose internal instructions"
		},
		{
			"code": "secret_disclosure",
			"pattern": "(?:sk-[a-z0-9_-]{12,}|Bearer\\s+[a-z0-9._-]{12,}|(?:api[_ -]?key|access[_ -]?token|password|secret)\\s*[:=]\\s*\\S+|BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY)",
			"description": "Assistant output contains secret-like material"
		},
		{
			"code": "provider_detail_disclosure",
			"pattern": "(?:OpenRouter|OPENROUTER_API_KEY|gpt-5\\.6-luna|x-ai/grok-voice)",
			"description": "Assistant disclosed provider implementation details"
		}
	],
	"piiToSpeech": {
		"policy": "TTS input must not contain phone, email, Telegram handle, raw URL, or internal identifier; visible text remains separately available",
		"patterns": [
			{
				"code": "pii_email_to_speech",
				"pattern": "[\\p{L}\\p{N}.!#$%&'*+/=?^_`{|}~-]+@[\\p{L}\\p{N}-]+(?:\\.[\\p{L}\\p{N}-]+)+"
			},
			{
				"code": "pii_telegram_to_speech",
				"pattern": "(?:^|[^\\p{L}\\p{N}])@[a-zA-Z][a-zA-Z0-9_]{3,31}\\b"
			},
			{
				"code": "pii_phone_to_speech",
				"pattern": "(?:^|[^\\p{L}\\p{N}])(?:\\+?\\d[\\d\\s().-]{5,}\\d)(?:$|[^\\p{L}\\p{N}])"
			},
			{ "code": "raw_url_to_speech", "pattern": "(?:https?://|www\\.)\\S+" },
			{
				"code": "internal_id_to_speech",
				"pattern": "\\b(?:bkg|conv|turn|gen|seg|call|thread|evt)_[a-zA-Z0-9_-]+\\b"
			}
		]
	},
	"toolPayloadToSpeechPatterns": [
		{
			"code": "tool_name_to_speech",
			"pattern": "\\b(?:create_booking|append_booking_qualification)\\b"
		},
		{
			"code": "tool_json_to_speech",
			"pattern": "(?:\\{\\s*\"|\"(?:bookingId|callId|conversationId)\"\\s*:)"
		},
		{
			"code": "system_payload_to_speech",
			"pattern": "(?:^|\\n)\\s*(?:system|tool|function|payload)\\s*[:=]"
		}
	]
}

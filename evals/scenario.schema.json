{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://botamin.local/evals/scenario.schema.json",
	"title": "Botamin offline conversation eval scenarios",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "scenarios"],
	"properties": {
		"schemaVersion": {
			"const": 1
		},
		"scenarios": {
			"type": "array",
			"minItems": 24,
			"items": {
				"$ref": "#/$defs/scenario"
			}
		}
	},
	"$defs": {
		"meetingSlot": {
			"type": "object",
			"additionalProperties": false,
			"required": ["startAt", "endAt", "timeZone", "durationMinutes"],
			"properties": {
				"startAt": {
					"type": "string",
					"format": "date-time",
					"pattern": "Z$"
				},
				"endAt": {
					"type": "string",
					"format": "date-time",
					"pattern": "Z$"
				},
				"timeZone": {
					"const": "Europe/Moscow"
				},
				"durationMinutes": {
					"const": 20
				}
			}
		},
		"slotCandidate": {
			"type": "object",
			"additionalProperties": false,
			"required": ["label", "meetingSlot"],
			"properties": {
				"label": {
					"type": "string",
					"minLength": 1
				},
				"meetingSlot": {
					"$ref": "#/$defs/meetingSlot"
				}
			}
		},
		"scenario": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"title",
				"tags",
				"language",
				"direction",
				"description",
				"expected"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]+$"
				},
				"title": {
					"type": "string",
					"minLength": 1
				},
				"tags": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"type": "string"
					}
				},
				"language": {
					"const": "ru"
				},
				"direction": {
					"enum": ["inbound", "outbound", "reactivation", "system"]
				},
				"description": {
					"type": "string",
					"minLength": 1
				},
				"serverContext": {
					"type": "object",
					"additionalProperties": false,
					"required": ["slotCandidates"],
					"properties": {
						"slotCandidates": {
							"type": "array",
							"minItems": 2,
							"maxItems": 2,
							"uniqueItems": true,
							"items": {
								"$ref": "#/$defs/slotCandidate"
							}
						}
					}
				},
				"expected": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"requiredStageOrder",
						"finalStages",
						"requiredEventOrder",
						"requiredSemantics",
						"forbiddenSemantics",
						"allowedTools",
						"booking",
						"allowedCaseClaimIds",
						"expectedFailureModes",
						"ttsMode"
					],
					"properties": {
						"requiredStageOrder": {
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						"finalStages": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "string"
							}
						},
						"requiredEventOrder": {
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						"requiredSemantics": {
							"type": "array",
							"uniqueItems": true,
							"items": {
								"type": "string"
							}
						},
						"forbiddenSemantics": {
							"type": "array",
							"uniqueItems": true,
							"items": {
								"type": "string"
							}
						},
						"allowedTools": {
							"type": "array",
							"uniqueItems": true,
							"items": {
								"enum": ["create_booking", "append_booking_qualification"]
							}
						},
						"booking": {
							"type": "object",
							"additionalProperties": false,
							"required": ["outcome", "maxCreateCalls", "qualification"],
							"properties": {
								"outcome": {
									"enum": ["required", "forbidden", "optional"]
								},
								"maxCreateCalls": {
									"type": "integer",
									"minimum": 0,
									"maximum": 2
								},
								"qualification": {
									"enum": ["none", "accepted", "declined", "optional"]
								}
							}
						},
						"allowedCaseClaimIds": {
							"type": "array",
							"uniqueItems": true,
							"items": {
								"type": "string"
							}
						},
						"expectedFailureModes": {
							"type": "array",
							"uniqueItems": true,
							"items": {
								"type": "string"
							}
						},
						"ttsMode": {
							"enum": ["required", "outage"]
						},
						"qualificationFlow": {
							"type": "object",
							"additionalProperties": false,
							"required": [
								"initialKnownFields",
								"expectedQuestionOrder",
								"refusalOutcome"
							],
							"properties": {
								"initialKnownFields": {
									"type": "array",
									"uniqueItems": true,
									"items": {
										"enum": ["monthlyLeadVolume", "salesManagerCount"]
									}
								},
								"expectedQuestionOrder": {
									"type": "array",
									"uniqueItems": true,
									"items": {
										"enum": [
											"monthlyLeadVolume",
											"salesManagerCount",
											"dailyLeadBasis"
										]
									}
								},
								"refusalOutcome": {
									"enum": ["none", "booking_preserved", "partial_preserved"]
								}
							}
						}
					}
				}
			}
		}
	}
}

{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"noEmit": true,
		"tsBuildInfoFile": "../node_modules/.cache/tests.tsbuildinfo",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["bun"]
	},
	"include": [
		"contracts/**/*.ts",
		"e2e/**/*.ts",
